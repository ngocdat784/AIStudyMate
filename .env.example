APP_ENV=development
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ALERT_AUTH_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ALERT_BOOTSTRAP_TOKEN=REPLACE_WITH_A_RANDOM_ONE_TIME_TOKEN
SECURITY_RATE_LIMITS_ENABLED=true

POSTGRES_DB=hardwareai
POSTGRES_USER=hardwareai
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://hardwareai:REPLACE_WITH_STRONG_RANDOM_PASSWORD@db:5432/hardwareai

# Optional Gemini provider; leave empty to use Python-only analytics.
GEMINI_API_KEY=

ALERT_SCHEDULER_ENABLED=true
HARDWARE_ANALYSIS_JOBS_ENABLED=true
HARDWARE_ANALYSIS_JOB_WORKERS=2

FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
